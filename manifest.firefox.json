{
	"manifest_version": 3,
	"name": "Quimera",
	"version": "1.0.0",
	"author": "b3xal",
	"description": "Inspect and manage browser-side authentication state during authorized web security testing.",
	"background": {
		"scripts": [
			"interface/lib/env.js",
			"interface/lib/browserDetector.js",
			"interface/lib/permissionHandler.js",
			"quimera.js"
		],
		"type": "module"
	},
	"action": {
		"default_icon": {
			"16": "icons/quimera-16.png",
			"32": "icons/quimera-32.png",
			"48": "icons/quimera-48.png",
			"128": "icons/quimera-128.png"
		},
		"default_title": "Quimera",
		"default_popup": "interface/popup/cookie-list.html"
	},
	"sidebar_action": {
		"default_icon": {
			"16": "icons/quimera-16.png",
			"32": "icons/quimera-32.png"
		},
		"default_title": "Quimera",
		"default_panel": "interface/sidepanel/cookie-list.html"
	},
	"devtools_page": "interface/devtools/devtool.html",
	"options_ui": {
		"page": "interface/options/options.html"
	},
	"permissions": [
		"cookies",
		"alarms",
		"tabs",
		"storage",
		"scripting"
	],
	"optional_host_permissions": [
		"<all_urls>",
		"http://127.0.0.1/*",
		"http://localhost/*"
	],
	"web_accessible_resources": [
		{
			"resources": [
				"content/inject-mainworld.js"
			],
			"matches": [
				"<all_urls>"
			]
		}
	],
	"icons": {
		"16": "icons/quimera-16.png",
		"19": "icons/quimera-19.png",
		"32": "icons/quimera-32.png",
		"48": "icons/quimera-48.png",
		"128": "icons/quimera-128.png"
	},
	"browser_specific_settings": {
		"gecko": {
			"id": "{8f41eb41-7c56-4370-961b-44cb1ccba23e}",
			"strict_min_version": "140.0",
			"data_collection_permissions": {
				"required": [
					"none"
				],
				"optional": [
					"authenticationInfo",
					"browsingActivity",
					"websiteContent"
				]
			}
		},
		"gecko_android": {
			"strict_min_version": "142.0"
		}
	}
}
